    "AGENTS.md"
  ],
  "skills": {
    "paths": [
      "~/.config/opencode/skills"
    ]
  },
  "agent": {
    "plan": {
      "disable": true
    }
  },
  "mcp": {
  },
  "provider": {
  }
}
